NODE_ENV=test
PORT=3011

# Esta base es exclusivamente para E2E. Nunca sustituir por chuydex_db.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=chuydex_e2e
DB_USER=chuydex_e2e_user
DB_PASSWORD=chuydex_e2e_password

DB_SYNCHRONIZE=false
DB_LOGGING=false
MYSQL_ROOT_PASSWORD=chuydex_e2e_root_password

JWT_ACCESS_SECRET=chuydex_e2e_access_secret_at_least_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=chuydex_e2e_refresh_secret_at_least_32_characters
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=10
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=chuydex_e2e_admin_password
CORS_ORIGIN=http://localhost:3011
