{
  "name": "chuydex-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST para la administración de ChuyDex",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix=false",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "test:e2e:up": "docker compose --env-file .env.test -f docker-compose.e2e.yml up -d --wait",
    "test:e2e:db": "docker compose --env-file .env.test -f docker-compose.e2e.yml up -d --wait && node test/e2e/run-e2e.js db",
    "test:e2e": "node test/e2e/run-e2e.js test",
    "start:e2e": "node test/e2e/run-api.js",
    "test:e2e:down": "docker compose --env-file .env.test -f docker-compose.e2e.yml down -v"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15", "@nestjs/config": "^3.3.0", "@nestjs/core": "^10.4.15", "@nestjs/jwt": "^10.2.0", "@nestjs/passport": "^10.0.3", "@nestjs/platform-express": "^10.4.15", "@nestjs/swagger": "^7.4.2", "@nestjs/throttler": "^6.2.1", "@nestjs/typeorm": "^10.0.2", "bcrypt": "^5.1.1", "class-transformer": "^0.5.1", "class-validator": "^0.14.1", "helmet": "^7.1.0", "joi": "^17.13.3", "mysql2": "^3.11.3", "passport": "^0.7.0", "passport-jwt": "^4.0.1", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.1", "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9", "@nestjs/schematics": "^10.2.3", "@nestjs/testing": "^10.4.15", "@types/bcrypt": "^5.0.2", "@types/express": "^4.17.21", "@types/jest": "^29.5.14", "@types/node": "^20.17.10", "@types/passport-jwt": "^4.0.1", "@typescript-eslint/eslint-plugin": "^7.18.0", "@typescript-eslint/parser": "^7.18.0", "eslint": "^8.57.1", "eslint-config-prettier": "^9.1.0", "eslint-plugin-prettier": "^5.2.1", "jest": "^29.7.0", "prettier": "^3.4.2", "source-map-support": "^0.5.21", "supertest": "^7.0.0", "ts-jest": "^29.2.5", "ts-node": "^10.9.2", "tsconfig-paths": "^4.2.0", "typescript": "^5.7.2"
  }
}
